    },
    {
      "name": "Landing Navigation",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "The landing-local logo treatment, in-page links, and login action.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-logo\" href=\"/\" aria-label=\"Finco home\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 448 512\" aria-hidden=\"true\"><path fill=\"#4948c9\" d=\"M248 106.6c18.9-9 32-28.3 32-50.6c0-30.9-25.1-56-56-56s-56 25.1-56 56c0 22.3 13.1 41.6 32 50.6v98.8c-2.8 1.3-5.5 2.9-8 4.7l-80.1-45.8c1.6-20.8-8.6-41.6-27.9-52.8C57.2 96 23 105.2 7.5 132S1.2 193 28 208.5c1.3.8 2.6 1.5 4 2.1v90.8c-1.3.6-2.7 1.3-4 2.1C1.2 319-8 353.2 7.5 380s49.7 36 76.5 20.5c19.3-11.1 29.4-32 27.8-52.8l50.5-28.9c-11.5-11.2-19.9-25.6-23.8-41.7l-50.5 29c-2.6-1.8-5.2-3.3-8-4.7v-90.8c2.8-1.3 5.5-2.9 8-4.7l80.1 45.8c-.1 1.4-.2 2.8-.2 4.3c0 22.3 13.1 41.6 32 50.6v98.8c-18.9 9-32 28.3-32 50.6c0 30.9 25.1 56 56 56s56-25.1 56-56c0-22.3-13.1-41.6-32-50.6v-98.8c2.8-1.3 5.5-2.9 8-4.7l80.1 45.8c-1.6 20.8 8.6 41.6 27.8 52.8c26.8 15.5 61 6.3 76.5-20.5s6.3-61-20.5-76.5c-1.3-.8-2.7-1.5-4-2.1v-90.8c1.4-.6 2.7-1.3 4-2.1c26.8-15.5 36-49.7 20.5-76.5s-49.5-36-76.3-20.5c-19.3 11.1-29.4 32-27.8 52.8l-50.6 28.9c11.5 11.2 19.9 25.6 23.8 41.7l50.6-29c2.6 1.8 5.2 3.3 8 4.7v90.8c-2.8 1.3-5.5 2.9-8 4.6l-80.1-45.8c.1-1.4.2-2.8.2-4.3c0-22.3-13.1-41.6-32-50.6v-98.8z\"/></svg><span>Finco</span></a><div class=\"ds-nav-links\"><a href=\"#how-it-works\">How it works</a><a href=\"#your-agents\">Meet your agents</a></div><a class=\"ds-nav-login\" href=\"/auth/login?returnTo=/ecosystem\">Log in</a></nav>",
      "css": ".ds-nav{font-family:Manrope,sans-serif;max-width:1360px;margin:auto;padding:30px 48px;display:flex;align-items:center;justify-content:space-between;gap:32px;background:#f9fafc;color:#20214a}.ds-nav a{color:inherit;text-decoration:none}.ds-logo{display:flex;align-items:center;gap:10px}.ds-logo span{font-size:24px;font-weight:700;letter-spacing:-.018em}.ds-nav-links{display:flex;gap:38px;font-size:14px;font-weight:600}.ds-nav-links a:hover{text-decoration:underline;text-underline-offset:5px}.ds-nav-login{padding:11px 23px;border:1px solid #cfd3e6;border-radius:100px;font-size:14px;font-weight:700}.ds-nav a:focus-visible{outline:3px solid #4948c9;outline-offset:5px;}@media(max-width:1050px){.ds-nav{padding-inline:32px}}@media(max-width:760px){.ds-nav{padding:22px 24px}.ds-nav-links{display:none}}"
    },
    {
      "name": "Demo Disclosure",
      "kind": "chip",
      "refersTo": "demo-tag",
      "description": "Passive disclosure that the financial example is illustrative.",
      "html": "<span class=\"ds-demo-tag\">Illustrative demo</span>",
      "css": ".ds-demo-tag{font-family:Manrope,sans-serif;display:inline-block;color:#575b76;font-size:11px;font-weight:500;padding:5px 8px;border:1px solid #babfe1;border-radius:6px}"
    },
    {
      "name": "Savings Destination",
      "kind": "card",
      "refersTo": "destination-savings",
      "description": "An emphasized route destination with tabular financial amounts.",
      "html": "<div class=\"ds-savings-destination\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M17 7 7 17\"/><path d=\"M17 17H7V7\"/></svg><div><span>Savings &amp; investing</span><strong>$800</strong></div></div>",
      "css": ".ds-savings-destination{font-family:Manrope,sans-serif;display:inline-flex;gap:12px;align-items:center;border-radius:14px;background:#4948c9;color:#fff;padding:17px 13px;font-size:11px}.ds-savings-destination>div{display:flex;flex-direction:column;gap:5px}.ds-savings-destination strong{font-size:24px;letter-spacing:-.025em;font-variant-numeric:tabular-nums;font-weight:700}"
    },
    {
      "name": "Remaining Money Destination",
      "kind": "card",
      "refersTo": "destination-remaining",
      "description": "Green label and confirmation icon identify remaining monthly money.",
      "html": "<div class=\"ds-remaining-destination\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><div><span>Room to breathe</span><strong>$3,593</strong></div></div>",
      "css": ".ds-remaining-destination{font-family:Manrope,sans-serif;display:inline-flex;gap:12px;align-items:center;border-radius:14px;background:#fff;color:#166953;padding:17px 13px;font-size:11px}.ds-remaining-destination>div{display:flex;flex-direction:column;gap:5px}.ds-remaining-destination strong{font-size:24px;letter-spacing:-.025em;font-variant-numeric:tabular-nums;font-weight:700}"
    },
    {
      "name": "Savings Control States",
      "kind": "button",
      "refersTo": "savings-control",
      "description": "The unpressed and pressed states of the monthly savings control; these previews are static.",
      "html": "<div class=\"ds-control-states\"><button class=\"ds-savings-control\" type=\"button\" aria-pressed=\"false\">+ Save another $200</button><button class=\"ds-savings-control\" type=\"button\" aria-pressed=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg> Save another $200</button></div>",
      "css": ".ds-control-states{display:flex;flex-wrap:wrap;gap:16px;background:#e8e9fc;padding:22px}.ds-savings-control{font-family:Manrope,sans-serif;display:inline-flex;align-items:center;gap:6px;background:#fff;color:#20214a;padding:11px 13px;border:0;border-radius:100px;white-space:nowrap;font-size:11px;font-weight:700;cursor:pointer}.ds-savings-control[aria-pressed=\"true\"]{background:#4948c9;color:#fff}.ds-savings-control:focus-visible{outline:3px solid #4948c9;outline-offset:5px;}"
    },
    {
      "name": "Agent Description",
      "kind": "card",
      "refersTo": "agent-row",
      "description": "An open, separated agent description without a raised container.",
      "html": "<article class=\"ds-agent\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"27\" height=\"27\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 7V5a2 2 0 0 1 2-2h2\"/><path d=\"M17 3h2a2 2 0 0 1 2 2v2\"/><path d=\"M21 17v2a2 2 0 0 1-2 2h-2\"/><path d=\"M7 21H5a2 2 0 0 1-2-2v-2\"/><path d=\"M7 12h10\"/></svg><h3>Sentinel</h3><strong>See the pressure points.</strong><p>Spot unusual spending and understand what is putting pressure on your finances.</p></article>",
      "css": ".ds-agent{font-family:Manrope,sans-serif;padding-top:28px;border-top:1px solid #cfd3e6;color:#20214a}.ds-agent>svg{color:#4948c9}.ds-agent h3{font-size:23px;font-weight:700;margin:22px 0 8px;letter-spacing:-.02em}.ds-agent strong{font-size:14px;font-weight:700}.ds-agent p{color:#575b76;font-size:14px;line-height:1.8;margin:15px 0 0;max-width:35ch}@media(max-width:760px){.ds-agent h3{margin-top:16px}.ds-agent p{max-width:50ch}}"
    },
    {
      "name": "Illustrative Money Route",
      "kind": "custom",
      "refersTo": "money-map",
      "description": "The signature financial route; a static snapshot of the landing demo before an extra contribution.",
      "html": "<div class=\"ds-map\" aria-label=\"Illustrative monthly money flow\"><div class=\"ds-map-header\"><span>Your money, connected</span><span class=\"ds-map-tag\">Illustrative demo</span></div><div class=\"ds-map-canvas\"><svg class=\"ds-map-connections\" viewBox=\"0 0 620 380\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><path d=\"M130 185 H245 Q265 185 265 165 V100 Q265 80 285 80 H410\"/><path d=\"M130 185 H410\"/><path d=\"M130 185 H245 Q265 185 265 205 V290 Q265 310 285 310 H410\"/><circle cx=\"265\" cy=\"185\" r=\"6\"/></svg><div class=\"ds-map-income\"><span class=\"ds-map-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"2\"/><path d=\"M6 12h.01M18 12h.01\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/></svg></span><span>Monthly income</span><strong>$8,500</strong><small>After tax</small></div><div class=\"ds-map-account\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10 18v-7\"/><path d=\"M11.12 2.198a2 2 0 0 1 1.76.006l7.866 3.847c.476.233.31.949-.22.949H3.474c-.53 0-.695-.716-.22-.949z\"/><path d=\"M14 18v-7\"/><path d=\"M18 18v-7\"/><path d=\"M3 22h18\"/><path d=\"M6 18v-7\"/></svg><span>Chequing</span></div><div class=\"ds-map-destination ds-map-spending\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"/><path d=\"M7 17 17 7\"/></svg><div><span>Everyday spending</span><strong>$4,107</strong></div></div><div class=\"ds-map-destination ds-map-savings\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M17 7 7 17\"/><path d=\"M17 17H7V7\"/></svg><div><span>Savings &amp; investing</span><strong>$800</strong></div><span class=\"ds-map-dot\"></span></div><div class=\"ds-map-destination ds-map-remaining\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><div><span>Room to breathe</span><strong>$3,593</strong></div></div></div></div>",
      "css": ".ds-map{font-family:Manrope,sans-serif;background:#e8e9fc;color:#20214a;border-radius:24px;padding:25px;position:relative}.ds-map-header{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:14px;font-weight:700}.ds-map-tag{color:#575b76;font-size:11px;font-weight:500;padding:5px 8px;border:1px solid #babfe1;border-radius:6px}.ds-map-canvas{height:360px;position:relative;margin:10px -10px}.ds-map-connections{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.ds-map-connections path{fill:none;stroke:#a3a6d5;stroke-width:2}.ds-map-connections circle{fill:#4948c9}.ds-map-income{position:absolute;left:2%;top:37%;display:flex;flex-direction:column;gap:4px;align-items:flex-start;font-size:11px}.ds-map-income strong{font-size:25px;font-weight:700;letter-spacing:-.025em}.ds-map-income small{color:#575b76}.ds-map-icon{background:#4948c9;color:#fff;border-radius:12px;padding:11px;margin-bottom:8px}.ds-map-account{position:absolute;left:37%;top:36%;display:flex;align-items:center;flex-direction:column;gap:8px;border-radius:50%;background:#e8e9fc;padding:17px;font-size:11px;color:#4948c9}.ds-map-destination{position:absolute;right:0;display:flex;gap:12px;align-items:center;width:43%;border-radius:14px;background:#fff;padding:17px 13px;font-size:11px;box-sizing:border-box}.ds-map-destination>div{display:flex;flex-direction:column;gap:5px}.ds-map-destination strong{font-size:24px;font-weight:700;letter-spacing:-.025em;font-variant-numeric:tabular-nums}.ds-map-spending{top:10%}.ds-map-savings{top:40%;background:#4948c9;color:#fff}.ds-map-remaining{top:73%;color:#166953}.ds-map-dot{position:absolute;left:-7px;height:14px;width:14px;border-radius:50%;background:#4948c9;border:3px solid #e8e9fc;box-sizing:border-box}@media(max-width:1050px){.ds-map{padding:20px}.ds-map-destination{padding:15px 9px}.ds-map-account{left:34%}}@media(max-width:760px){.ds-map-canvas{height:350px}}@media(max-width:400px){.ds-map{padding:16px}.ds-map-