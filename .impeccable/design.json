      "html": "<a class=\"ds-secondary\" href=\"/ecosystem\">Explore the demo</a>",
      "css": ".ds-secondary{font-family:Manrope,sans-serif;color:#20214a;font-size:14px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.ds-secondary:hover{text-decoration:underline}.ds-secondary:focus-visible{outline:3px solid #4948c9;outline-offset:5px;}"
