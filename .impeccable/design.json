  "components": [
    {
      "name": "Primary Action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The indigo pill action used to start a financial ecosystem.",
      "html": "<a class=\"ds-primary\" href=\"/auth/login?screen_hint=signup&amp;returnTo=/onboarding\">Build your ecosystem <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"/><path d=\"M7 17 17 7\"/></svg></a>",
      "css": ".ds-primary{font-family:Manrope,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:14px;background:#4948c9;color:#fff;padding:16px 24px;border-radius:100px;font-size:14px;font-weight:700;text-decoration:none;transition:background .18s cubic-bezier(.16,1,.3,1)}.ds-primary:hover{background:#33329f}.ds-primary:focus-visible{outline:3px solid #4948c9;outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
